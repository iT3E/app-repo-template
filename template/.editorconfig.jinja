# editorconfig.org (tnwks-ops' .editorconfig, plus [[ 'Go' if language == 'go' else 'Python' ]])
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[% if language == 'go' %]
[{*.go,go.mod,go.sum}]
# gofmt: tabs
indent_style = tab
indent_size = 4
[% else %]
[*.py]
indent_size = 4
[% endif %]

[Makefile]
indent_style = tab

[*.{bash,sh}]
indent_style = space
indent_size = 4

[bin/*]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
