{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // The app-repo presets from iT3E/app-template (renovate/), pinned to the
  // template release this repo is on; a template update moves the pin.
  // Repo-only rules go below the extends; copier update keeps them.
  extends: [
    "github>iT3E/app-template//renovate/default.json5#[[ _commit ]]",
    "github>iT3E/app-template//renovate/[[ language ]].json5#[[ _commit ]]",
  ],
}
