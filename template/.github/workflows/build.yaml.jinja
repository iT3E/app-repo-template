---
name: "Build"

# Managed by Copier from https://github.com/iT3E/app-repo-template (see
# .copier-answers.yml). The logic is in the reusable workflow it calls, from
# https://github.com/iT3E/github-workflows. The template pins that release
# (@<sha> # vX.Y.Z), and a template release moves it here as a
# `copier update` PR.
#
[% if language == 'go' %]
# go: gofmt, go vet, golangci-lint (PRs, new issues only), go test -race.
[% else %]
# python: compileall (plus ruff and tests where enabled).
[% endif %]
[% if has_image %]
# image: Docker build on PRs[% if image_push_main %]; push :main and :sha-<short> from main[% endif %];
# push :<version> and :sha-<short> from a v* tag (release.yaml dispatches
# this workflow on the tags it creates). Never :latest.
[% endif %]
on:
  pull_request:
  push:
    branches: ["main"]
    tags: ["v*"]
  workflow_dispatch:

permissions: {}

# One run per ref. PR runs cancel each other; main and tag runs queue.
concurrency:
  group: build-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
[% if language == 'go' %]
  go:
    name: go
    permissions:
      contents: read
    uses: iT3E/github-workflows/.github/workflows/go.yaml@[[ github_workflows_sha ]] # [[ github_workflows_ref ]]
[% if go_version != 'go.mod' or extra_test_command %]
    with:
[% if go_version != 'go.mod' %]
      go-version: "[[ go_version ]]"
[% endif %]
[% if extra_test_command %]
      extra-test-command: |
        [[ extra_test_command | trim | indent(8) ]]
[% endif %]
[% endif %]
[% else %]
  python:
    name: python
    permissions:
      contents: read
    uses: iT3E/github-workflows/.github/workflows/python.yaml@[[ github_workflows_sha ]] # [[ github_workflows_ref ]]
    with:
      python-version: "[[ python_version ]]"
[% if extra_test_command %]
      test-command: |
        [[ extra_test_command | trim | indent(8) ]]
[% endif %]
[% endif %]
[% if has_image %]

  image:
    name: image
    needs: ["[[ language ]]"]
    permissions:
      contents: read
      packages: write
    uses: iT3E/github-workflows/.github/workflows/image.yaml@[[ github_workflows_sha ]] # [[ github_workflows_ref ]]
    with:
[% if image_name %]
      image: [[ image_name ]]
[% endif %]
      push-main: [[ image_push_main | lower ]]
      privacy-gate: [[ 'tree' if image_push_main else 'history' ]]
[% if image_test_command %]
      test-command: |
        [[ image_test_command | trim | indent(8) ]]
[% endif %]
[% if image_test_command and image_test_postgres %]
      postgres: true
[% endif %]
    secrets:
      PRIVACY_TERMS: ${{ secrets.PRIVACY_TERMS }}
[% endif %]
