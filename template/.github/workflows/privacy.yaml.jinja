---
name: "Privacy"

# Managed by Copier from https://github.com/iT3E/app-template (see
# .copier-answers.yml). The logic is in the reusable workflow it calls;
# change that in the template, and a template release reaches this repo as
# a `copier update` PR. The @<sha> pin is that release.
#
# bin/privacy-check on every tracked file and path, the commits the event
# adds (messages and identities) and the PR title and body, against the
# PRIVACY_TERMS secret (task privacy:sync). A missing secret fails: a
# private repo has no fork PRs. Exceptions: .github/privacy-allow.
on:
  pull_request:
    # edited: a changed title or body is checked again.
    types: [opened, synchronize, reopened, edited]
  push:
    branches: ["main"]
[% if has_image and not image_push_main %]
    # The tag's image ships the whole history, so check all of it.
    tags: ["v*"]
[% endif %]

permissions: {}

jobs:
  privacy:
    name: privacy
    permissions:
      contents: read
    uses: iT3E/app-template/.github/workflows/privacy.yaml@[[ _copier_conf.vcs_ref_hash ]] # [[ _commit ]]
    secrets:
      PRIVACY_TERMS: ${{ secrets.PRIVACY_TERMS }}
