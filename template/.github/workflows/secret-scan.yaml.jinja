---
name: "Secret Scan"

# Managed by Copier from https://github.com/iT3E/app-template (see
# .copier-answers.yml). The logic is in the reusable workflow it calls;
# change that in the template, and a template release reaches this repo as
# a `copier update` PR. The @<sha> pin is that release.
#
# betterleaks over the commits a PR (or a push to main) adds, with
# .betterleaks.toml. The server-side twin of the pre-commit hook.
on:
  pull_request:
  push:
    branches: ["main"]

permissions: {}

jobs:
  betterleaks:
    name: betterleaks
    permissions:
      contents: read
    uses: iT3E/app-template/.github/workflows/secret-scan.yaml@[[ _copier_conf.vcs_ref_hash ]] # [[ _commit ]]
